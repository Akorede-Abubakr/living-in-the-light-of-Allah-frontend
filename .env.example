# Local Vite proxy. Cloudflare build: https://api.your-domain.example/api
VITE_API_BASE_URL=/api
# Optional upload origin/CDN; defaults to the absolute API URL's origin.
VITE_MEDIA_BASE_URL=
# Vite development proxy only; never bundled into the browser.
DEV_API_PROXY_TARGET=http://localhost:5000

# Restored Speech-to-Text settings.
VITE_SPEECH_MAX_SECONDS=59
VITE_SPEECH_MAX_BYTES=10485760
VITE_SPEECH_TIMEOUT_MS=810000
